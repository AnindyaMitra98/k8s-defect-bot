#cloud-config
# Brings the node to the point where the bot *could* be installed, and stops
# there: k3s running, Docker available to build the image, Helm on PATH, and the
# source cloned. It deliberately does NOT build or install anything -- that is a
# manual step (see README.md), which keeps Terraform out of the app's lifecycle
# and makes this runbook the thing under test.
#
# This runs as EC2 user_data, not as a Terraform provisioner. It executes on the
# instance regardless of what the apply is doing, so a slow or failed bootstrap
# cannot leave `terraform apply` in a half-finished state.
package_update: true
package_upgrade: false

packages:
  - docker.io
  - git
  - curl
  - jq

write_files:
  - path: /opt/bootstrap.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail

      systemctl enable --now docker
      usermod -aG docker ubuntu

      # The public IP is only knowable from inside the instance, and k3s bakes it
      # into the API server certificate. Without it as a SAN, kubectl from your
      # workstation fails certificate validation against <public-ip>:6443.
      TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
      PUBLIC_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/public-ipv4)

      curl -sfL https://get.k3s.io | \
        INSTALL_K3S_VERSION="${k3s_version}" \
        sh -s - server \
          --write-kubeconfig-mode 644 \
          --tls-san "$PUBLIC_IP" \
          --node-name "${node_name}"

      # k3s reports "installed" well before the API server answers and the node
      # goes Ready. Wait for the real thing, up to five minutes.
      for _ in $(seq 1 60); do
        if k3s kubectl get nodes 2>/dev/null | grep -qw Ready; then break; fi
        sleep 5
      done

      curl -sfL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

%{ if clone_repo ~}
      # Cloned, not built. The node builds whatever is pushed to this branch, so
      # local uncommitted changes are not under test until you push them.
      git clone --branch "${repo_branch}" --depth 1 "${repo_url}" /home/ubuntu/k8s-defect-bot
      chown -R ubuntu:ubuntu /home/ubuntu/k8s-defect-bot
%{ endif ~}

      # k3s writes its kubeconfig here; put it on the PATH for every login shell
      # so `kubectl` on the node just works.
      echo 'export KUBECONFIG=/etc/rancher/k3s/k3s.yaml' > /etc/profile.d/k3s.sh

      # Sentinel. `set -e` above means this file only exists if every step above
      # succeeded -- check it first when something looks wrong, then read
      # /var/log/cloud-init-output.log.
      touch /opt/bootstrap.done

runcmd:
  - [bash, /opt/bootstrap.sh]
